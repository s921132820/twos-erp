<Window x:Class="LabelPrinter.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LabelPrinter"
        Width="620"
        Height="720"
        MinWidth="560"
        MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Loaded="MainWindow_OnLoaded"
        Closed="MainWindow_OnClosed"
        Background="#F3F5F8">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Padding="28,22" Background="White">
            <StackPanel>
                <TextBlock FontSize="24"
                           FontWeight="Bold"
                           Text="수입축산물 라벨 출력" />
                <TextBlock Margin="0,6,0,0"
                           Foreground="{StaticResource MutedTextBrush}"
                           Text="품목과 수량을 선택한 후 출력하세요." />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="28,24,28,28">
                <Border Padding="24"
                        Background="White"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <StackPanel>
                        <TextBlock Style="{StaticResource FieldLabelStyle}"
                                   Text="품목명" />
                        <ComboBox Height="42"
                                  Padding="10,6"
                                  ItemsSource="{Binding Products}"
                                  SelectedItem="{Binding SelectedProduct, UpdateSourceTrigger=PropertyChanged}"
                                  SelectionChanged="ProductComboBox_OnSelectionChanged"
                                  DisplayMemberPath="ProductName"
                                  IsEnabled="{Binding IsNotLoading}"
                                  IsEditable="True"
                                  IsTextSearchEnabled="True"
                                  StaysOpenOnEdit="True"
                                  ToolTip="출력할 품목을 선택하세요." />

                        <TextBlock Margin="0,22,0,8"
                                   Style="{StaticResource FieldLabelStyle}"
                                   Text="출력 수량" />
                        <DockPanel LastChildFill="True">
                            <TextBlock DockPanel.Dock="Right"
                                       Width="32"
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       Text="장" />
                            <TextBox Style="{StaticResource InputStyle}"
                                     HorizontalContentAlignment="Right"
                                     MaxLength="4"
                                     Text="{Binding PrintQuantity, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="출력할 라벨 수량을 입력하세요." />
                        </DockPanel>
                    </StackPanel>
                </Border>

                <Border Margin="0,18,0,0"
                        Padding="24"
                        Background="White"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" FontWeight="SemiBold" Text="원산지" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding OriginCountry}" />

                        <TextBlock Grid.Row="1" Margin="0,16,0,0" FontWeight="SemiBold" Text="유통기한" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,16,0,0" Text="{Binding ExpirationDate}" />

                        <TextBlock Grid.Row="2" Margin="0,16,0,0" FontWeight="SemiBold" Text="이력번호" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,16,0,0" Text="{Binding TraceNumber}" />

                        <TextBlock Grid.Row="3" Margin="0,16,0,0" FontWeight="SemiBold" Text="수입업체" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,16,0,0" Text="{Binding ImporterName}" />
                    </Grid>
                </Border>

                <TextBlock Margin="4,16,4,12"
                           Foreground="{StaticResource MutedTextBrush}"
                           Text="{Binding StatusMessage}"
                           TextWrapping="Wrap" />

                <Button Style="{StaticResource PrimaryButtonStyle}"
                        Content="출력"
                        ToolTip="라벨 출력을 시작합니다." />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
