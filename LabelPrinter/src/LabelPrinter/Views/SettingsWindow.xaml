<Window x:Class="LabelPrinter.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="출력 설정"
        Width="460"
        Height="410"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#F3F5F8">
    <Grid Margin="24">
        <Border Padding="24"
                Background="White"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8">
            <StackPanel>
                <TextBlock FontSize="21" FontWeight="Bold" Text="프린터 설정" />

                <TextBlock Margin="0,22,0,8"
                           Style="{StaticResource FieldLabelStyle}"
                           Text="사용할 프린터" />
                <ComboBox Height="42"
                          Padding="10,6"
                          ItemsSource="{Binding PrinterNames}"
                          SelectedItem="{Binding SelectedPrinterName}" />

                <Grid Margin="0,20,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="라벨 가로(mm)" />
                        <TextBox Style="{StaticResource InputStyle}"
                                 Text="{Binding LabelWidthMm, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="라벨 세로(mm)" />
                        <TextBox Style="{StaticResource InputStyle}"
                                 Text="{Binding LabelHeightMm, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Grid>

                <TextBlock MinHeight="38"
                           Margin="0,16,0,10"
                           Foreground="{StaticResource MutedTextBrush}"
                           Text="{Binding StatusMessage}"
                           TextWrapping="Wrap" />

                <Button Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding SaveCommand}"
                        Content="설정 저장" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
