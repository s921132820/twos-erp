{
  "name": "twos-erp",
  "private": true,
  "packageManager": "pnpm@11.10.0",
  "workspaces": [
    "electron",
    "client",
    "server",
    "prisma"
  ],
  "scripts": {
    "dev": "pnpm --parallel dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "format": "pnpm -r format",
    "start": "pnpm --filter electron start",
    "db:push": "pnpm --filter prisma db:push",
    "db:generate": "pnpm --filter prisma generate",
    "clean": "rimraf node_modules .pnpm pnpm-lock.yaml dist"
  },
  "devDependencies": {
    "rimraf": "^5.0.0"
  }
}
